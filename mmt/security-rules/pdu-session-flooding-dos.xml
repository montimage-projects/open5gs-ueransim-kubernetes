<beginning>

<!--
This rule detects whether 5G traffic in control plane: 
  one UE must not send two consecutive UplinkNASTransport messages during X seconds

Note: in the boolean_expression below, we use: 
- ngap.procedure_code == 29: indicate PDUSessionResourceSetup
- ngap.procedure_code == 46: indicate UplinkNASTransport
- sctp.dest_port == 38412  : focus on control plane (?)
- ip.src != ip.dst         : this is mainly to print IP src and dest to alert reports
- ngap.ran_ue_id == ngap.ran_ue_id.1: the two events have the same ngap.ran_ue_id
-->

<property value="THEN" delay_units="s" delay_min="0" delay_max="10" property_id="301" type_property="ATTACK" 
    description="5G DoS attack in the control plane: too many PDU session establishment requests">
  <event value="COMPUTE" event_id="1" 
    description="NGAP PDUSessionResourceSetup: IP allocated by AMF"
    boolean_expression="((ngap.procedure_code == 29) &amp;&amp; ((sctp.src_port == 38412) &amp;&amp;(ip.src != ip.dst )))"/>

  <event value="COMPUTE" event_id="2" 
    description="NGAP UplinkNASTransport: UE requests another IP"
    boolean_expression="((ngap.procedure_code == 46) &amp;&amp; ((sctp.dest_port == 38412) &amp;&amp;(ngap.ran_ue_id == ngap.ran_ue_id.1)))"/>
</property>
</beginning>